<?xml version="1.0" encoding="UTF-8"?>
<!--
    Privacy Manifest — required by Apple since 2024-05.
    Docs: https://developer.apple.com/documentation/bundleresources/privacy_manifest_files

    This manifest declares:
      1. Whether the app tracks users across apps/websites (we do NOT).
      2. Which categories of user data the app collects (uuid, purchases,
         gameplay progress).
      3. Which "Required Reason APIs" (RRA) the app calls, and why.

    The 4 RRAs declared below are conservatively over-declared: Cocos
    Creator's iOS runtime touches all of them for engine-internal purposes
    (settings persistence, asset caching, uptime measurement, storage
    availability). Apple accepts these standard reasons for game engines.

    Update this file when:
      - We add a new third-party SDK that has its own data-collection
      - We add cross-app tracking (SKAdNetwork, advertising IDs, etc.)
      - We integrate new APIs from Apple's Required Reason list

    Category strings are Apple's fixed vocabulary — don't invent new ones.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ================================================================
         Section 1: Tracking
         We DO track for advertising: Unity LevelPlay mediates rewarded
         ads with 4 adapters (AdMob, Meta Audience Network, Unity Ads,
         AppLovin). When the ATT prompt grants authorization, those
         adapters receive IDFA + device info and may link it to
         third-party ad data for frequency capping, attribution and
         personalisation. Hence NSPrivacyTracking = true.
         ================================================================ -->
    <key>NSPrivacyTracking</key>
    <true/>

    <!-- Domains that MUST load only after ATT authorization. Per Apple's
         docs, list every host the mediated ad SDKs reach for tracking
         purposes. These sets are maintained by each SDK vendor; the
         values below are the vendor-published tracking domains as of
         2026 Q4. Review when any ad adapter is bumped. -->
    <key>NSPrivacyTrackingDomains</key>
    <array>
        <!-- Unity LevelPlay / ironSource -->
        <string>ssa.aura.ironsrc.com</string>
        <string>ssa.aura.ssacdn.com</string>
        <string>init.supersonicads.com</string>
        <string>outcome-ssp.supersonicads.com</string>
        <string>cs.supersonicads.com</string>
        <!-- Google AdMob -->
        <string>googleads.g.doubleclick.net</string>
        <string>pagead2.googlesyndication.com</string>
        <string>pubads.g.doubleclick.net</string>
        <!-- Meta Audience Network -->
        <string>graph.facebook.com</string>
        <string>an.facebook.com</string>
        <!-- Unity Ads -->
        <string>auction.unityads.unity3d.com</string>
        <string>config.unityads.unity3d.com</string>
        <string>publisher-config.unityads.unity3d.com</string>
        <string>cdn-highwinds.unityads.unity3d.com</string>
        <!-- AppLovin -->
        <string>ms.applovin.com</string>
        <string>a.applvn.com</string>
        <string>d.applvn.com</string>
        <string>stats.applovin.com</string>
    </array>

    <!-- ================================================================
         Section 2: Collected Data Types
         Per Apple: only list things that leave the device. The three
         server-bound types (UserID / PurchaseHistory / OtherUserContent)
         are sent to our own backend (tetritower.konenine.kr).
         DeviceID (IDFA + IDFV) leaves the device via the LevelPlay
         mediated ad adapters when the player grants ATT.
         ================================================================ -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- 0) Device ID (IDFA + IDFV). Collected by Unity LevelPlay +
             its 4 ad adapters (AdMob / Meta / UnityAds / AppLovin) when
             ATT authorization is granted. Used by those SDKs for
             advertising attribution + frequency capping + targeting.
             Tracking = true because the identifier is linked to
             third-party ad data server-side. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

        <!-- 1) Player UUID (server-issued identifier).
             Linked to identity (it IS the identity from our POV).
             Not used for tracking. Purpose = app functionality (needed
             to persist wallet balance, leaderboard entries, purchase
             history across sessions/devices). -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- 2) Purchase History (which gem SKU was bought, when, for how
             much). Server-side purchase_log — needed for player-visible
             purchase history + tax/receipt records + fraud-refund
             reconciliation. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- 3) Other User Content — game progress + leaderboard scores.
             We send: current level, best-score-per-mode, endless attempt
             history. Not sensitive per se, but Apple wants it declared
             since it leaves the device. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <!-- ================================================================
         Section 3: Required Reason APIs
         Apple's fingerprinting-abuse-prevention list. For each API
         category we call, we must justify with one of Apple's approved
         reason codes. Cocos Creator's runtime touches these four:
         ================================================================ -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults: Cocos engine stores audio settings (volume,
             mute), language preference, tutorial-complete flags here.
             Reason CA92.1: "Access info from same app, per documentation." -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>

        <!-- File Timestamp: Cocos asset system compares file mtimes
             against remote-config timestamps for hot-update logic +
             cache invalidation.
             Reason C617.1: "Access files inside the app container." -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>

        <!-- System Boot Time: Cocos uses monotonic time (based on boot
             uptime) for frame pacing + tween accuracy.
             Reason 35F9.1: "Measure elapsed time within the app scope." -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>

        <!-- Disk Space: Cocos checks free space before downloading
             hot-update packs / caching remote assets.
             Reason E174.1: "Show disk space to the user." -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
