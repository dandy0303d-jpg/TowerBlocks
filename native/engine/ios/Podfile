# Podfile — Google Mobile Ads (AdMob) integration.
#
# Cocos regenerates the Xcode project at build/<target>/proj/ on each
# native build, so this Podfile is copied there by CMakeLists.txt
# (configure_file at generation time) — do NOT hand-edit the copy in
# build/, edit THIS file at native/engine/ios/Podfile.
#
# One-time setup on the machine that will build for TestFlight:
#   1. Install CocoaPods:   sudo gem install cocoapods
#   2. cd build/ios-release/proj
#   3. pod install
#   4. Open "Tetri Tower.xcworkspace" (NOT .xcodeproj — the workspace
#      knows about Pods; the plain project does not).
#
# Subsequent Cocos rebuilds:
#   Cocos may overwrite the .xcodeproj. If Xcode complains about
#   missing GoogleMobileAds framework after a rebuild, re-run:
#      cd build/ios-release/proj && pod install
#   The workspace + Pods dir persist across Cocos regens.

platform :ios, '15.0'
use_frameworks!

# Explicit project path — after a clean regen the xcodeproj is
# named from CMake's project() call ("tower_blocks.xcodeproj"),
# not the display name Cocos sometimes wraps it with. Pin
# explicitly so pod install doesn't guess wrong.
#
# CMake generates FOUR build configurations (Debug / Release /
# MinSizeRel / RelWithDebInfo). CocoaPods only knows :debug and
# :release by default; the extra two need an explicit mapping,
# otherwise their xcconfig references get dropped and framework
# search paths never make it into the CocosGame target.
project 'tower_blocks.xcodeproj',
        'Debug'          => :debug,
        'Release'        => :release,
        'MinSizeRel'     => :release,
        'RelWithDebInfo' => :release

# The actual target in the generated project. Cocos rewrites the
# CMake-declared EXECUTABLE_NAME to "CocosGame" in the final Xcode
# project (visible via `xcodebuild -project "Tetri Tower.xcodeproj" -list`).
# Don't change this even if you tweak APP_NAME in CMakeLists.
target 'CocosGame' do
  # Core AdMob SDK. Interstitial + rewarded ad formats included in
  # the base pod. Pin to a known-good major version to avoid surprise
  # breaking changes; bump after testing with each Google release.
  pod 'Google-Mobile-Ads-SDK', '~> 11.0'

  # Firebase pods removed — the FirebaseAnalytics XCFramework + Cocos
  # 3.8.8 CMake-generated project combination caused persistent
  # header-search-path and link-time issues. Re-integrate via Swift
  # Package Manager (Xcode's native, friendlier path for binary
  # frameworks) when restoring Analytics / Crashlytics / Remote Config.
end

# Silence Xcode 15 sandbox warnings on newer CocoaPods versions and
# ensure Pods deployment target matches app target (avoids
# "compiling for iOS 12.0, but module ... requires iOS 15.0" errors).
#
# ALSO — force the Pods xcconfig onto the user target's Base
# Configuration for every config. Cocos-generated targets ship with
# no base config and CocoaPods' auto-attach can miss it silently
# (leaves Framework Search Paths empty → Swift `import GoogleMobileAds`
# fails). This makes the integration self-healing across regens.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # Rosetta compat on Apple Silicon Macs when building for the
      # simulator — otherwise fat-arch link errors on some Pods.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end

  # Force-attach Pods xcconfig to the user target's base configuration,
  # AND strip settings Cocos hardcoded at target level that would
  # override Pods' xcconfig values. `OTHER_SWIFT_FLAGS` in particular
  # carries the `-Xcc -fmodule-map-file=...` flags Swift needs to
  # resolve `import GoogleMobileAds`; if CocosGame overrides it, the
  # module lookup silently fails.
  #
  # Deleting the target-level entry lets Pods' xcconfig win. If Cocos
  # regenerates and re-adds them, pod install runs this again and
  # heals the target.
  CLOBBERED_KEYS = %w[
    OTHER_SWIFT_FLAGS
    ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES
  ].freeze

  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_targets.each do |user_target|
      user_target.build_configurations.each do |config|
        xcconfig_path = aggregate_target.xcconfig_relative_path(config.name)
        # Find or create the file reference under a "Pods" group so the
        # setting shows up in Xcode's Info → Configurations UI.
        group = aggregate_target.user_project.main_group['Pods'] ||
                aggregate_target.user_project.new_group('Pods')
        file_ref = group.files.find { |f| f.path == xcconfig_path } ||
                   group.new_file(xcconfig_path)
        config.base_configuration_reference = file_ref

        # Strip clobbering target-level settings so Pods xcconfig wins.
        CLOBBERED_KEYS.each { |k| config.build_settings.delete(k) }
      end
    end
    aggregate_target.user_project.save
  end
end
