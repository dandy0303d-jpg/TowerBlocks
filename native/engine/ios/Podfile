# Podfile — Unity LevelPlay (formerly ironSource) via CocoaPods.
#
# Reverted from Swift Package Manager after SPM's "Preparing to
# validate..." step repeatedly hung on the AppLovin adapter inside
# Cocos 3.8.8's CMake-generated Xcode project. LevelPlay's CocoaPods
# distribution has been battle-tested for years and plays nicely with
# CMake-generated projects, unlike the Firebase XCFramework pods which
# caused the earlier Firebase-removal saga.
#
# One-time setup on each clone:
#   1. Install CocoaPods:   sudo gem install cocoapods
#   2. cd build/<build-id>/proj
#   3. pod install
#   4. Open "tower_blocks.xcworkspace" (NOT .xcodeproj — the workspace
#      knows about Pods; the plain project does not).
#
# Subsequent Cocos rebuilds:
#   Cocos may overwrite the .xcodeproj. CMakeLists.txt auto-runs
#   `pod install` after regen (see service/ads block + the Post hook);
#   if Xcode complains about missing IronSource framework, run it
#   manually: `cd build/<build-id>/proj && pod install`.

platform :ios, '15.0'
use_frameworks!

# Explicit project path — after a clean regen the xcodeproj is
# named from CMake's project() call ("tower_blocks.xcodeproj"),
# not the display name Cocos sometimes wraps it with. Pin
# explicitly so pod install doesn't guess wrong.
#
# CMake generates FOUR build configurations (Debug / Release /
# MinSizeRel / RelWithDebInfo). CocoaPods only knows :debug and
# :release by default; the extra two need an explicit mapping,
# otherwise their xcconfig references get dropped and framework
# search paths never make it into the CocosGame target.
project 'tower_blocks.xcodeproj',
        'Debug'          => :debug,
        'Release'        => :release,
        'MinSizeRel'     => :release,
        'RelWithDebInfo' => :release

# The actual target in the generated project. Cocos rewrites the
# CMake-declared EXECUTABLE_NAME to "CocosGame" in the final Xcode
# project (visible via `xcodebuild -project "Tetri Tower.xcodeproj" -list`).
# Don't change this even if you tweak APP_NAME in CMakeLists.
target 'CocosGame' do
  # Core LevelPlay SDK. Pod name is still `IronSourceSDK` even after
  # the Unity rebrand. `~> 9.5` pulls the latest 9.5.x so bug-fix
  # releases land without re-pinning; bump the minor manually when
  # jumping to 9.6/10.0.
  pod 'IronSourceSDK', '~> 9.5'

  # Mediation adapters — one per network. Each adapter pod transitively
  # pulls its network's own SDK (e.g. the AdMob adapter pulls
  # Google-Mobile-Ads-SDK), so no separate network pods are needed.
  #
  # No version pin: IronSource's adapter versioning (A.B.C.D.E) doesn't
  # map cleanly to CocoaPods' SemVer resolver and exact-pinning tends
  # to hit "no spec found" because minor adapter revs land fast. The
  # unpinned pods resolve to the latest version that is compatible with
  # IronSourceSDK ~> 9.5; verify in Podfile.lock after each `pod install`
  # and freeze there if you want reproducibility across machines.
  pod 'IronSourceUnityAdsAdapter'   # Unity Ads
  pod 'IronSourceAdMobAdapter'      # Google AdMob
  pod 'IronSourceFacebookAdapter'   # Meta Audience Network (pod kept 'Facebook')
  pod 'IronSourceAppLovinAdapter'   # AppLovin MAX
end

# post_install does two surgical fixes, nothing more. We let CocoaPods
# handle baseConfigurationReference attachment on its own (the previous
# manual attach loop was fighting the default integration).
#
# Fix 1 — Pod-vs-Pod xcconfig conflict:
#   FBAudienceNetwork and IronSourceAdQualitySDK both set
#   EXCLUDED_ARCHS[sdk=iphonesimulator*] in their podspecs but to
#   different values, which triggers "Can't merge user_target_xcconfig"
#   4 times and causes CocoaPods to skip some xcconfig merging into
#   the user target. Force them to the same value (arm64 — the standard
#   exclusion when building for simulator on Apple Silicon with pods
#   that only ship x86_64 slices).
#
# Fix 2 — CocosGame target overrides Pods xcconfig:
#   Cocos's CMake writes OTHER_SWIFT_FLAGS and
#   ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES directly into CocosGame's
#   target-level build settings. Those override whatever the Pods
#   xcconfig sets at config-level, so Swift module lookup for IronSource
#   silently fails. Deleting the target-level entries lets Pods'
#   xcconfig values win via Base Configuration inheritance.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # Fix 1: unify the conflicting simulator exclusion value across
      # all pod targets.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end

  # Fix 2: strip CocosGame's target-level overrides for the two
  # settings the Pods xcconfig cares about. CocoaPods will warn
  # "target overrides ..." without this.
  CLOBBERED_KEYS = %w[
    OTHER_SWIFT_FLAGS
    ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES
  ].freeze

  # Fix 3: force-attach the Pods xcconfig as CocosGame's Base
  # Configuration for every build config. CocoaPods normally does
  # this automatically, but the "Can't merge user_target_xcconfig"
  # error from Fix 1's conflicting pods makes it SKIP this step
  # silently, which leaves pbxproj with zero baseConfigurationReference
  # entries → FRAMEWORK_SEARCH_PATHS never flow in → Swift fails to
  # find the IronSource module. Manually walking aggregate_targets +
  # setting base_configuration_reference puts the integration back
  # on the rails that CocoaPods abandoned.
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_targets.each do |user_target|
      user_target.build_configurations.each do |config|
        xcconfig_path = aggregate_target.xcconfig_relative_path(config.name)
        group = aggregate_target.user_project.main_group['Pods'] ||
                aggregate_target.user_project.new_group('Pods')
        file_ref = group.files.find { |f| f.path == xcconfig_path } ||
                   group.new_file(xcconfig_path)
        config.base_configuration_reference = file_ref
        CLOBBERED_KEYS.each { |k| config.build_settings.delete(k) }
      end
    end
    aggregate_target.user_project.save
  end
end
