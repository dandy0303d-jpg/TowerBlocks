// 重力压制 - 光环（顶部压制盖 / 落地冲击波）（加法混合、双面、不写深度）
// Cocos Creator 3.8.x
// 用于 1x1 的水平面片（XZ 平面，中心在原点），大小由节点缩放控制（脚本会自动生成网格）。
CCEffect %{
  techniques:
  - name: additive
    passes:
    - vert: ring-vs:vert
      frag: ring-fs:frag
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: zero
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        mainColor: { value: [0.3, 0.68, 1.0, 1.0], linear: true, editor: { type: color } }
        params:    { value: [0.72, 0.05, 1.0, 24.0], editor: { tooltip: 'x=环半径0~1 y=环宽 z=强度 w=虚线段数(0=实线)' } }
        params2:   { value: [0.0, 0.6, 0.5, 0.0], editor: { tooltip: 'x=旋转相位(脚本驱动) y=内部填充 z=外圈细环强度 w=保留' } }
}%

CCProgram ring-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  out vec3 v_local;

  vec4 vert () {
    vec4 position;
    CCVertInput(position);

    mat4 matWorld;
    CCGetWorldMatrix(matWorld);

    v_local = position.xyz;
    return cc_matProj * (cc_matView * matWorld) * position;
  }
}%

CCProgram ring-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/output>

  in vec3 v_local;

  uniform RingConstants {
    vec4 mainColor;
    vec4 params;
    vec4 params2;
  };

  vec4 frag () {
    vec2 p    = v_local.xz * 2.0;                                  // -1 ~ 1
    float r   = length(p);
    float ang = atan(p.y, p.x) / 6.2831853 + 0.5;

    float radius = max(params.x, 0.001);
    float w      = max(params.y, 0.001);

    // 主环（可选虚线 + 旋转）
    float ring = 1.0 - smoothstep(0.0, w, abs(r - radius));
    if (params.w > 0.5) {
      float d = fract(ang * params.w + params2.x);
      ring *= smoothstep(0.0, 0.08, d) * (1.0 - smoothstep(0.55, 0.65, d));
    }

    // 外圈细环
    float ring2 = (1.0 - smoothstep(0.0, w * 0.5, abs(r - (radius + w * 2.5)))) * params2.z;

    // 环内能量填充：越靠近环越亮
    float fill = smoothstep(0.0, radius, r) * (1.0 - step(radius, r)) * params2.y * 0.5;

    float mask = 1.0 - smoothstep(0.95, 1.0, r);
    float a = clamp((ring + ring2 + fill) * params.z * mask, 0.0, 1.0);

    vec3 col = mainColor.rgb * (1.0 + ring * 0.6);
    return CCFragOutput(vec4(col, a));
  }
}%
