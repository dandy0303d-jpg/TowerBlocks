// 塔快速旋转 - 螺旋气流罩（加法混合、双面、不写深度）
// Cocos Creator 3.8.x
// 用于「半径 1、高 1、中心在原点」的开口圆柱体，大小由节点缩放控制（脚本自动生成网格）。
// 流动相位由 SpinTowerEffect.ts 按转速累加写入，速度变化时不会跳帧。
CCEffect %{
  techniques:
  - name: additive
    passes:
    - vert: swirl-vs:vert
      frag: swirl-fs:frag
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: zero
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        mainColor: { value: [0.75, 0.55, 1.0, 1.0], linear: true, editor: { type: color } }
        params:    { value: [1.0, 0.0, 7.0, 1.2], editor: { tooltip: 'x=整体强度 y=旋转相位(脚本驱动) z=气流条数 w=螺旋扭曲' } }
        params2:   { value: [6.0, 0.3, 1.0, 0.0], editor: { tooltip: 'x=拖尾锐度 y=边缘光 z=方向(1/-1) w=保留' } }
}%

CCProgram swirl-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  out vec3 v_local;
  out vec3 v_worldPos;
  out vec3 v_worldNormal;

  vec4 vert () {
    vec4 position;
    CCVertInput(position);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    v_local = position.xyz;
    vec4 worldPos = matWorld * position;
    v_worldPos = worldPos.xyz;
    v_worldNormal = normalize((matWorldIT * vec4(a_normal, 0.0)).xyz);
    return cc_matProj * (cc_matView * worldPos);
  }
}%

CCProgram swirl-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/output>

  in vec3 v_local;
  in vec3 v_worldPos;
  in vec3 v_worldNormal;

  uniform SwirlConstants {
    vec4 mainColor;
    vec4 params;
    vec4 params2;
  };

  vec4 frag () {
    float h   = v_local.y + 0.5;                                   // 0 底 ~ 1 顶
    float ang = atan(v_local.z, v_local.x) / 6.2831853 + 0.5;      // 0~1 环绕

    vec3 V = normalize(cc_cameraPos.xyz - v_worldPos);
    float rim = pow(1.0 - abs(dot(normalize(v_worldNormal), V)), 2.0);

    float edge = smoothstep(0.0, 0.15, h) * (1.0 - smoothstep(0.8, 1.0, h));

    // 螺旋气流：亮头在前，拖尾在后
    float s = fract(ang * params.z + h * params.w + params.y);
    if (params2.z < 0.0) s = 1.0 - s;
    float streak = pow(1.0 - s, params2.x);

    // 沿高度打散成一缕一缕
    float wisp = 0.5 + 0.5 * sin(h * 18.0 + ang * 18.849556 + params.y * 2.0);
    streak *= mix(0.45, 1.0, wisp);

    float a = (0.05 + rim * params2.y + streak * (0.5 + rim)) * edge;
    a = clamp(a * params.x, 0.0, 1.0);

    vec3 col = mainColor.rgb * (1.0 + streak * 0.5) + vec3(streak * streak * 0.25);
    return CCFragOutput(vec4(col, a));
  }
}%
